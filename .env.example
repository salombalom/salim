# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع ملف .env إلى GitHub أبداً (هو مستثنى في .gitignore).
# Copy to .env and fill in. Never commit .env.

# ───── التطبيق (تُقرأ داخل التطبيق — آمنة للنشر لأنها عامة بطبيعتها) ─────
# من لوحة Supabase: Project Settings → API  (تُستخدم من المرحلة 2)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ───── مفاتيح سرية — لا تُوضع في التطبيق إطلاقاً ─────
# تُحفظ كأسرار في Supabase Edge Functions:
#   npx supabase secrets set YOUTUBE_API_KEY=... ANTHROPIC_API_KEY=...
# (تُستخدم من المرحلتين 3 و4) — مذكورة هنا للتوثيق فقط.
# YOUTUBE_API_KEY=
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
