{
  "expo": {
    "name": "دَرْسي",
    "slug": "darsi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "darsi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "om.darsi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C4CF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "om.darsi.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C4CF5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "تطبيق تعليمي مجاني لطلاب المدارس في سلطنة عُمان",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}