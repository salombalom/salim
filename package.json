  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:seed-sql": "tsx tools/build-seed-sql.ts",
    "db:test": "bash supabase/tests/run.sh",
    "db:login": "npx -y supabase@3.3.0 login",
    "db:link": "npx -y supabase@3.3.0 link",
    "db:push": "npx -y supabase@3.3.0 db push --remote --include-seed",
    "publish:preview": "npx -y eas-cli@27.11.0 update --branch preview --environment preview --platform all",
    "videos": "tsx --env-file-if-exists=.env tools/videos.ts",
    "textbooks:fetch": "tsx tools/fetch-textbooks.ts",
    "questions": "tsx tools/questions.ts",
    "summaries": "tsx --env-file-if-exists=.env tools/summaries.ts",
    "store:privacy": "tsx tools/build-privacy-html.ts",
    "icons": "node tools/generate-icons.js"
  },
  "private": true
